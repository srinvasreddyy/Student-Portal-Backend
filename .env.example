# ==========================================
# Application Environment Configuration
# ==========================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# 2. Database Configuration
MONGO_URI=mongodb://localhost:27017/student_platform

# 3. Security & Authentication (JWT)
# IMPORTANT: JWT_SECRET must be at least 32 characters in production
JWT_SECRET=super_secret_minimum_32_chars_length_hash!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_token_key_here

# 4. Email / SMTP Configuration
# Uses Ethereal Email by default for local development. 
# Swap with SendGrid/AWS SES/Mailgun for production.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here

#   (Optional defaults, usually managed in code, but good to have explicit)
#   FROM_EMAIL=noreply@studentplatform.com
#   ADMIN_EMAIL=admin@studentplatform.com

# 5. External API Integrations
# Companies House API (For verifying UK companies)
COMPANIES_HOUSE_API_KEY=your_companies_house_key_here

# OpenCorporates API (For verifying global companies)
OPENCORPORATES_TOKEN=your_opencorporates_token_here

# 6. File Upload Constraints (Optional overrides)
# MAX_FILE_SIZE_BYTES=10485760 # 10MB
